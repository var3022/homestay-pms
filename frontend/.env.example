# Homestay PMS - Frontend Environment Configuration
# Copy this file to .env.local for local development.

# Spring Boot Backend API Base URL
PMS_API_BASE_URL=http://localhost:8080

# Default Property ID (UUID)
PMS_PROPERTY_ID=a0000000-0000-0000-0000-000000000001

# Session Encryption Secret for AES-256-GCM Cookie (Minimum 32 characters required in all environments)
PMS_SESSION_SECRET=change-this-to-a-secure-random-32-character-secret-in-production!

# Frontend Canonical Origin (Used for CSRF validation and backend Origin header)
PMS_FRONTEND_ORIGIN=http://localhost:3000
